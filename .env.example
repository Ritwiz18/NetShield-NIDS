# ==================================================
# NetShield-NIDS Production Environment Configuration
# ==================================================
# Template file for environment settings.
# Copy to `.env` for local custom configuration.
# Do NOT put passwords, secrets, or API keys in this file.

# ── Container & Host Port Mappings ──
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── API Base Endpoint URL ──
# Used by frontend client services. Leave as http://localhost:8000 for local setup,
# or set to "" (empty) when serving behind an Nginx reverse proxy / domain.
API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# ── Container & Application Logging Level ──
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Host Network Interface for Scapy Packet Sniffing (Optional) ──
# Display name or substring of host network interface (e.g. eth0, wlan0, "Wi-Fi").
# If left blank, NetShield will automatically discover and select the active default interface with an IP address.
HOST_INTERFACE=

# ── Cloud VM & Linux Network Sniffing Notes ──
# On Linux Cloud VMs, Scapy live packet capture requires socket raw capabilities.
# Ensure docker-compose.yml contains:
#   cap_add:
#     - NET_ADMIN
#     - NET_RAW
# For direct physical host interface sniffing on Linux VMs, enable:
#   network_mode: host
